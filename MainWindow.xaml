<Window x:Class="korzunov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список товаров" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Background="#EEEEEE">
            <Button Content="Выйти" Click="LogoutButton_Click" DockPanel.Dock="Left"/>
            <TextBlock Name="UserLabel" DockPanel.Dock="Right" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <StackPanel Name="FilterPanel" DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock Text="Поиск:" VerticalAlignment="Center"/>
            <TextBox Name="SearchBox" Width="200" TextChanged="Search_Changed"/>
            <TextBlock Text="Поставщик:" VerticalAlignment="Center"/>
            <ComboBox Name="SupplierBox" Width="160" SelectionChanged="Combo_Changed"/>
            <TextBlock Text="Сортировка:" VerticalAlignment="Center"/>
            <ComboBox Name="SortBox" Width="160" SelectionChanged="Combo_Changed"/>
        </StackPanel>

        <StackPanel Name="AdminPanel" DockPanel.Dock="Bottom" Orientation="Horizontal">
            <Button Content="Добавить товар" Click="AddButton_Click"/>
            <Button Content="Удалить товар" Click="DeleteButton_Click"/>
        </StackPanel>

        <DataGrid Name="ProductsGrid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  LoadingRow="ProductsGrid_LoadingRow"
                  MouseDoubleClick="ProductsGrid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул"      Binding="{Binding Article}"          Width="80"/>
                <DataGridTextColumn Header="Наименование"  Binding="{Binding Name}"             Width="140"/>
                <DataGridTextColumn Header="Категория"     Binding="{Binding CategoryName}"     Width="110"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding ManufacturerName}" Width="110"/>
                <DataGridTextColumn Header="Поставщик"     Binding="{Binding SupplierName}"     Width="100"/>
                <DataGridTextColumn Header="Цена"          Binding="{Binding Price}"            Width="70"/>
                <DataGridTextColumn Header="Кол-во"        Binding="{Binding Stock}"            Width="60"/>
                <DataGridTextColumn Header="Скидка %"      Binding="{Binding Discount}"         Width="70"/>
                <DataGridTextColumn Header="Описание"      Binding="{Binding Description}"      Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>