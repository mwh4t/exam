<Window x:Class="korzunov.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="520" Width="340"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel>
        <TextBlock Text="Артикул:"/>
        <TextBox Name="ArticleBox"/>
        <TextBlock Text="Наименование:"/>
        <TextBox Name="NameBox"/>
        <TextBlock Text="Описание:"/>
        <TextBox Name="DescBox"/>
        <TextBlock Text="Категория:"/>
        <ComboBox Name="CategoryBox"/>
        <TextBlock Text="Производитель:"/>
        <ComboBox Name="ManufacturerBox"/>
        <TextBlock Text="Поставщик:"/>
        <ComboBox Name="SupplierBox"/>
        <TextBlock Text="Цена:"/>
        <TextBox Name="PriceBox"/>
        <TextBlock Text="Скидка %:"/>
        <TextBox Name="DiscountBox"/>
        <TextBlock Text="Количество на складе:"/>
        <TextBox Name="StockBox"/>
        <TextBlock Name="ErrorText" Foreground="Red"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="SaveButton_Click"/>
            <Button Content="Отмена" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>