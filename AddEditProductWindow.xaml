<Window x:Class="exam.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="500" Width="380"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20">

        <TextBlock Text="Артикул:" Margin="0,0,0,4"/>
        <TextBox Name="ArticleBox" Margin="0,0,0,10"/>

        <TextBlock Text="Наименование:" Margin="0,0,0,4"/>
        <TextBox Name="NameBox" Margin="0,0,0,10"/>

        <TextBlock Text="Описание:" Margin="0,0,0,4"/>
        <TextBox Name="DescBox" Margin="0,0,0,10"/>

        <TextBlock Text="Категория:" Margin="0,0,0,4"/>
        <ComboBox Name="CategoryBox" Margin="0,0,0,10"/>

        <TextBlock Text="Производитель:" Margin="0,0,0,4"/>
        <ComboBox Name="ManufacturerBox" Margin="0,0,0,10"/>

        <TextBlock Text="Поставщик:" Margin="0,0,0,4"/>
        <ComboBox Name="SupplierBox" Margin="0,0,0,10"/>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Цена:" Margin="0,0,0,4"/>
                <TextBox Name="PriceBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Скидка %:" Margin="0,0,0,4"/>
                <TextBox Name="DiscountBox"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Кол-во на складе:" Margin="0,0,0,4"/>
        <TextBox Name="StockBox" Margin="0,0,0,14"/>

        <TextBlock Name="ErrorText" Foreground="Red" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="SaveButton_Click"
                    Margin="0,0,10,0" Padding="14,4"/>
            <Button Content="Отмена" Click="CancelButton_Click"
                    Padding="14,4"/>
        </StackPanel>

    </StackPanel>
</Window>
    
