<Window x:Class="korzunov.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="320" Width="320"
        WindowStartupLocation="CenterScreen">
    <StackPanel>
        <TextBlock Text="ООО «Обувь»" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="Логин:"/>
        <TextBox Name="LoginBox"/>
        <TextBlock Text="Пароль:"/>
        <PasswordBox Name="PasswordBox"/>
        <TextBlock Name="ErrorText" Foreground="Red"/>
        <Button Content="Войти" Click="LoginButton_Click"/>
        <Button Content="Войти как гость" Click="GuestButton_Click"/>
    </StackPanel>
</Window>